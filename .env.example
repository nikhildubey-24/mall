# Gmail SMTP for enquiry emails (generate app password at https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="acropolismallg@gmail.com"
SMTP_APP_PASSWORD="your-gmail-app-password"
