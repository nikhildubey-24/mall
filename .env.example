# NextAuth v5 reads AUTH_SECRET for JWT signing. Required in production.
AUTH_SECRET="generate-a-secret-here"
ADMIN_EMAIL="admin@acropolismall.com"
ADMIN_PASSWORD="change-this-password"

# Site contact settings (fallbacks for local dev/testing; empty = use DB values)
NEXT_PUBLIC_PHONE=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
